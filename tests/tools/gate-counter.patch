-		if (isChildIdentityEstablished(ni, oi)) return true;
-		if (isOrderConsistent(ctx, ni, oi)) return true;
-
+		if (ni.name.equals(oi.name)) { GATE_ALLOW.incrementAndGet(); return true; }
+		if (hasDiscriminatingConsumer(ctx, ni, oi)) { GATE_ALLOW.incrementAndGet(); return true; }
+		if (isSkeletonGloballyUnique(ctx, ni, oi)) { GATE_ALLOW.incrementAndGet(); return true; }
+		if (isChildIdentityEstablished(ni, oi)) { GATE_ALLOW.incrementAndGet(); return true; }
+		if (isOrderConsistent(ctx, ni, oi)) { GATE_ALLOW.incrementAndGet(); return true; }
+		GATE_FALLBACK_REFUSED.incrementAndGet();
+		gateNote(ctx, ni, oi, "fallback-exhausted");
 		warnBodyMismatch(ctx, oi, ni);
